# Copy to .env and fill in. NEVER commit the real .env - it is gitignored.

SIGIL_DB=sigil.db
SIGIL_FIXTURES=fixtures

# Findings below this confidence are never shown. The single most important
# knob in the product: raising it trades recall for credibility.
SIGIL_REPORT_THRESHOLD=0.5

# REQUIRED before exposing ingest endpoints to any network. Empty = no auth.
SIGIL_ADMIN_TOKEN=

# Set false to run fully offline against local fixtures only.
SIGIL_ALLOW_REMOTE_INGEST=true
